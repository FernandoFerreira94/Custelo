# =============================================================================
# Custelo — variaveis de ambiente
#
# ESTE ARQUIVO NAO CARREGA VALORES. Apenas nomes e formato.
# Valores reais vivem em Vercel Environment Variables e Supabase Vault (ADR-019).
# Nunca commitar .env / .env.local.
#
# Regra dura (ADR-019): staging JAMAIS aponta para o numero de WhatsApp real de
# um cliente nem para dado de producao.
# =============================================================================

NODE_ENV=development

# --- Banco (ADR-003 / ADR-006) ------------------------------------------------
# Conexao Postgres direta (Drizzle). NAO usar PostgREST para dominio.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Supabase (ADR-005 Auth / ADR-008 Storage) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role ignora RLS. Restrita a jobs especificos, NUNCA em codigo de
# request e NUNCA exposta ao cliente (ADR-004).
SUPABASE_SERVICE_ROLE_KEY=

# --- Jobs duraveis (ADR-009) --------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- WhatsApp Cloud API (ADR-015) ---------------------------------------------
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- OCR / LabelExtractor (ADR-014) -------------------------------------------
# Fornecedor especifico ainda e OPEN QUESTION. Criterio de escolha:
# nao retencao de imagem · latencia < 2s p95 · custo por imagem · regiao.
LABEL_EXTRACTOR_API_KEY=

# --- Observabilidade (ADR-016) ------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Analytics (ADR-017) ------------------------------------------------------
# SEM PII. Nunca nome, telefone, unidade ou conteudo de etiqueta.
# O audit log vive no Postgres e nunca e enviado para ca.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Testes -------------------------------------------------------------------
E2E_BASE_URL=http://localhost:3000
